{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/munkeymomo/orbit/host-protocol-v1.schema.json",
  "title": "ORBIT host protocol 1",
  "description": "What a host application hands ORBIT when ORBIT runs embedded. Two documents: the handshake and a verse (one arrangement of the host's records as galaxies, systems and planets). Kinds and families are strings the host defines; ORBIT attaches no meaning to them beyond the colour and label the host gives.",
  "oneOf": [{ "$ref": "#/$defs/handshake" }, { "$ref": "#/$defs/verse" }, { "$ref": "#/$defs/unchanged" }],
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "day": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "caps": {
      "description": "What may be changed on one record. Anything missing is false.",
      "type": "object",
      "properties": {
        "edit": { "type": "boolean" },
        "status": { "type": "boolean" },
        "move": { "type": "boolean" },
        "delete": { "type": "boolean" },
        "create": { "type": "boolean", "description": "On a system: planets may be added to it." },
        "attach": { "type": "boolean", "description": "On a task: attachments may be added or taken off." },
        "reason": {
          "type": "array",
          "items": { "enum": ["delete", "drop"] },
          "description": "Changes the host only accepts with a reason."
        }
      },
      "additionalProperties": false
    },
    "open": {
      "description": "Something the host can show on a page of its own. Opaque to ORBIT; handed back to host.open().",
      "type": "object",
      "properties": { "kind": { "type": "string" }, "id": { "type": "string" }, "label": { "type": "string" } },
      "required": ["kind", "id"],
      "additionalProperties": false
    },
    "also": {
      "description": "The same record (or galaxy) in another verse: a wormhole.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "verse": { "$ref": "#/$defs/id" },
          "galaxy": { "$ref": "#/$defs/id" },
          "system": { "$ref": "#/$defs/id" },
          "object": { "$ref": "#/$defs/id" },
          "note": { "type": "string", "description": "What the record means there, in a few words." }
        },
        "required": ["verse"],
        "additionalProperties": false
      }
    },
    "family": {
      "type": "object",
      "properties": {
        "label": { "type": "string" },
        "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
      },
      "required": ["label", "color"],
      "additionalProperties": false
    },
    "fact": {
      "type": "object",
      "properties": { "label": { "type": "string" }, "value": { "type": "string" } },
      "required": ["label", "value"],
      "additionalProperties": false
    },
    "verseInfo": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string" },
        "plain": { "type": "string", "description": "The plain word shown under the name." },
        "legend": { "type": "string", "description": "One line: what size, colour, ring and moons mean here." },
        "editable": { "type": "boolean" },
        "shown": { "type": "boolean", "description": "False when the person has hidden this verse." }
      },
      "required": ["id", "name", "plain", "legend", "editable"],
      "additionalProperties": false
    },
    "handshake": {
      "type": "object",
      "properties": {
        "protocol": { "const": 1 },
        "host": {
          "type": "object",
          "properties": { "name": { "type": "string" }, "version": { "type": "string" } },
          "required": ["name"],
          "additionalProperties": false
        },
        "orbit_build": {
          "type": "object",
          "properties": {
            "version": { "type": "string" },
            "commit": { "type": "string" },
            "sha256": { "type": "string" }
          },
          "additionalProperties": false
        },
        "caps": {
          "description": "What the host allows as a whole.",
          "type": "object",
          "properties": {
            "write": { "type": "boolean", "description": "Host-owned tasks can be changed." },
            "personal": { "type": "boolean", "description": "The host keeps ORBIT's own galaxies, projects and tasks." },
            "work": { "type": "boolean", "description": "The host keeps working state (parking, sessions, the day plan) for its tasks." },
            "pick": { "type": "array", "items": { "type": "string" }, "description": "Families host.pick() answers." },
            "actions": { "type": "array", "items": { "type": "string" }, "description": "Ids host.action() answers." },
            "adopt": { "type": "boolean", "description": "host.adopt() takes ORBIT's own systems and their tasks (\"Move to <host>…\"). Used together with personal and work." }
          },
          "additionalProperties": false
        },
        "verses": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/verseInfo" } },
        "start": { "$ref": "#/$defs/id", "description": "The verse to open first." },
        "labels": {
          "description": "The host's own words for a few fixed strings.",
          "type": "object",
          "properties": { "open": { "type": "string" }, "stored": { "type": "string" } },
          "additionalProperties": false
        },
        "locked": { "type": "string", "description": "Set while the host refuses changes to its records; the text says why." }
      },
      "required": ["protocol", "host", "caps", "verses"],
      "additionalProperties": false
    },
    "unchanged": {
      "type": "object",
      "properties": { "verse": { "$ref": "#/$defs/id" }, "rev": { "type": "string" }, "unchanged": { "const": true } },
      "required": ["verse", "rev", "unchanged"],
      "additionalProperties": false
    },
    "galaxy": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string" },
        "color": { "type": "string" },
        "status": { "type": "string", "description": "Shown on the galaxy's chip." },
        "chip": { "type": "string", "description": "The chip's text, e.g. a kind and a status." },
        "finished": { "type": "boolean", "description": "Hidden unless finished galaxies are shown." },
        "cluster": { "$ref": "#/$defs/id" },
        "virtual": { "type": "boolean", "description": "Not a record of the host's: a holder for loose systems." },
        "facts": { "type": "array", "items": { "$ref": "#/$defs/fact" } },
        "caps": { "$ref": "#/$defs/caps" },
        "open": { "$ref": "#/$defs/open" },
        "also": { "$ref": "#/$defs/also" }
      },
      "required": ["id", "name"],
      "additionalProperties": false
    },
    "cluster": {
      "description": "A faint label around galaxies that belong together.",
      "type": "object",
      "properties": { "id": { "$ref": "#/$defs/id" }, "name": { "type": "string" }, "open": { "$ref": "#/$defs/open" } },
      "required": ["id", "name"],
      "additionalProperties": false
    },
    "system": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "galaxy": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }], "description": "null = deep space." },
        "name": { "type": "string" },
        "code": { "type": "string" },
        "status": { "type": "string" },
        "note": { "type": "string" },
        "color": { "type": "string" },
        "virtual": { "type": "boolean", "description": "A holder the host made up (e.g. for tasks filed nowhere)." },
        "portal": {
          "description": "This system leads to another verse.",
          "type": "object",
          "properties": { "verse": { "$ref": "#/$defs/id" }, "label": { "type": "string" } },
          "required": ["verse"],
          "additionalProperties": false
        },
        "count": { "type": "integer", "minimum": 0, "description": "How many things it stands for, when the planets are only some of them." },
        "facts": { "type": "array", "items": { "$ref": "#/$defs/fact" } },
        "caps": { "$ref": "#/$defs/caps" },
        "open": { "$ref": "#/$defs/open" },
        "also": { "$ref": "#/$defs/also" }
      },
      "required": ["id", "galaxy", "name"],
      "additionalProperties": false
    },
    "attachment": {
      "description": "A moon: something a planet uses or holds.",
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "link": { "type": "string", "description": "The host's id for the tie itself, handed back when it is taken off." },
        "kind": { "type": "string" },
        "family": { "type": "string" },
        "label": { "type": "string" },
        "sub": { "type": "string" },
        "state": { "enum": ["live", "archived", "gone"] },
        "flag": { "enum": ["changed"], "description": "Drawn in red: it changed since it was attached." },
        "open": { "$ref": "#/$defs/open" },
        "also": { "$ref": "#/$defs/also" }
      },
      "required": ["id", "kind", "family", "label", "state"],
      "additionalProperties": false
    },
    "planet": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "system": { "$ref": "#/$defs/id" },
        "type": { "enum": ["task", "item"] },
        "title": { "type": "string" },
        "notes": { "type": "string" },
        "status": { "enum": ["todo", "done"], "description": "Tasks only." },
        "dropped": { "type": "boolean", "description": "Done without being done: shown struck through." },
        "priority": { "enum": [1, 2, 3, 4] },
        "due": { "anyOf": [{ "$ref": "#/$defs/day" }, { "type": "null" }] },
        "completedAt": { "anyOf": [{ "type": "number" }, { "type": "null" }] },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" },
        "note": { "type": "string", "description": "A short remark from the host shown with the planet." },
        "kind": { "type": "string", "description": "Items: the host's kind." },
        "family": { "type": "string", "description": "Items: decides the colour." },
        "sub": { "type": "string" },
        "state": { "enum": ["live", "archived", "gone"] },
        "size": { "type": "number", "minimum": 0, "description": "Items: what the size stands for, as a number." },
        "ring": { "type": "number", "minimum": 0, "maximum": 1, "description": "Items: the share the ring shows." },
        "facts": { "type": "array", "items": { "$ref": "#/$defs/fact" } },
        "ghost": { "type": "boolean", "description": "Shown outside its home galaxy; its only action is the way home." },
        "attachments": { "type": "array", "items": { "$ref": "#/$defs/attachment" } },
        "more": { "type": "integer", "minimum": 0, "description": "Attachments the host counted but did not send." },
        "caps": { "$ref": "#/$defs/caps" },
        "open": { "$ref": "#/$defs/open" },
        "also": { "$ref": "#/$defs/also" }
      },
      "required": ["id", "system", "type", "title"],
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "task" } } },
          "then": { "required": ["status", "priority"] }
        },
        {
          "if": { "properties": { "type": { "const": "item" } } },
          "then": { "required": ["kind", "family"] }
        }
      ],
      "additionalProperties": false
    },
    "collection": {
      "description": "A belt: what a system holds that no planet uses. Items when few, counts when many.",
      "type": "object",
      "properties": {
        "system": { "$ref": "#/$defs/id" },
        "total": { "type": "integer", "minimum": 0 },
        "items": { "type": "array", "items": { "$ref": "#/$defs/attachment" } },
        "counts": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "open": { "$ref": "#/$defs/open" }
      },
      "required": ["system", "total"],
      "additionalProperties": false
    },
    "beacon": {
      "description": "A date that matters: drawn on a galaxy's rim or beside a system.",
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "galaxy": { "$ref": "#/$defs/id" },
        "system": { "$ref": "#/$defs/id" },
        "code": { "type": "string" },
        "title": { "type": "string" },
        "due": { "anyOf": [{ "$ref": "#/$defs/day" }, { "type": "null" }] },
        "state": { "enum": ["planned", "soon", "late", "achieved", "rescoped"] },
        "serves": { "type": "integer", "minimum": 0, "description": "Open tasks that serve it." },
        "open": { "$ref": "#/$defs/open" }
      },
      "required": ["id", "title", "state"],
      "anyOf": [{ "required": ["galaxy"] }, { "required": ["system"] }],
      "additionalProperties": false
    },
    "arrow": {
      "description": "A relation between two planets of one verse (never 'blocked by').",
      "type": "object",
      "properties": {
        "from": { "$ref": "#/$defs/id" },
        "to": { "$ref": "#/$defs/id" },
        "label": { "type": "string" }
      },
      "required": ["from", "to"],
      "additionalProperties": false
    },
    "verse": {
      "type": "object",
      "properties": {
        "verse": { "$ref": "#/$defs/id" },
        "rev": { "type": "string", "description": "Changes whenever anything in the verse may have changed." },
        "families": { "type": "object", "additionalProperties": { "$ref": "#/$defs/family" } },
        "clusters": { "type": "array", "items": { "$ref": "#/$defs/cluster" } },
        "galaxies": { "type": "array", "items": { "$ref": "#/$defs/galaxy" } },
        "systems": { "type": "array", "items": { "$ref": "#/$defs/system" } },
        "planets": { "type": "array", "items": { "$ref": "#/$defs/planet" } },
        "collections": { "type": "array", "items": { "$ref": "#/$defs/collection" } },
        "beacons": { "type": "array", "items": { "$ref": "#/$defs/beacon" } },
        "arrows": { "type": "array", "items": { "$ref": "#/$defs/arrow" } }
      },
      "required": ["verse", "rev", "families", "galaxies", "systems", "planets"],
      "additionalProperties": false
    }
  }
}
